# Firebase SDK config — copy to .env and fill in your project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Comma-separated list of Google account emails that can upload and delete games.
# Must match the email list in firestore.rules — that file is the server-side enforcement.
VITE_ARCHIVIST_EMAILS=you@gmail.com
