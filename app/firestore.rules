rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the URL can read — friends view the archive without signing in.
    // Writes restricted to authorized playgroup archivists via Google Sign-In.
    //
    // IMPORTANT: Keep this email list in sync with AUTHORIZED_EMAILS in
    // src/adapters/firestore.ts — that list is the client-side UX gate;
    // this list is the actual server-side enforcement layer.
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.email in [
          'willcarey119@gmail.com'
        ];
    }
  }
}
