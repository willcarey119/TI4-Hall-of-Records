rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the URL can read games.
    // Writes require anonymous Firebase auth — effectively "only users with
    // the project's API keys", which are gitignored and private to this repo.
    match /games/{gameId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}