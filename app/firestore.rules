rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Anyone with the URL can read games
    match /games/{gameId} {
      allow read: if true;
      // Only allowlisted writer UIDs can write
      allow write: if request.auth != null
        && request.auth.uid in [
          'REPLACE_WITH_YOUR_UID'
        ];
    }
  }
}